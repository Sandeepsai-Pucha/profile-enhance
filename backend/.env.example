# ── Database ──────────────────────────────────────────────────
# Set USE_SQLITE=true for local dev/testing (no PostgreSQL needed)
# Set USE_SQLITE=false and configure DATABASE_URL for production
USE_SQLITE=true

# ── PostgreSQL (only used when USE_SQLITE=false) ─────────────
# NOTE: special characters in passwords must be URL-encoded (@  →  %40)
DATABASE_URL=postgresql://postgres:password@localhost:5432/skillify_db

# ── Auth / JWT ────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-random-32-char-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Google OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# ⚠️  In Google Cloud Console → OAuth credentials → Authorized redirect URIs
# make sure this is added: http://localhost:8000/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── Frontend ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── AI Providers ──────────────────────────────────────────────
# Options: claude | gemini | ollama | groq
AI_PROVIDER=claude

# Gemini (services/ai_service.py) — free tier at https://aistudio.google.com/
API_KEY=your-gemini-api-key

# Claude (services/claude_service.py) — https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Groq (services/groq_service.py)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant

# Ollama (services/ollama_service.py) — only used when AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Google Drive resume folders (routers/indexing.py) ────────
DIGITAL_DRIVE_FOLDER_ID=
QA_DRIVE_FOLDER_ID=
SALESFORCE_DRIVE_FOLDER_ID=

# ── Default Google Drive folder for resume indexing ───────────
DEFAULT_DRIVE_FOLDER_ID=

# ── Local resumes for testing (skips Google Drive) ────────────
# Set USE_LOCAL_RESUMES=true to read from a local .txt file instead of Drive
USE_LOCAL_RESUMES=false
LOCAL_RESUMES_FILE=../sample-resumes.txt

# ── Pipeline tuning (routers/pipeline.py) ─────────────────────
BM25_PREFILTER_K=50

# ── Resume storage (services/resume_storage_service.py) ───────
RESUMES_DIR=resumes
